# Copy to .env.macos and change the password before exposing the service.
QWEN_TTS_ACCESS_PASSWORD=change-me
HOST=0.0.0.0
PORT=7861

# GGUF model quality. Q4_K_M is fastest/smallest; Q8_0 is higher fidelity.
QWEN_TTS_QUANT=Q4_K_M

# Keep one lane by default on unified memory. Benchmark before increasing.
QWEN_TTS_0_6B_LANES=1
QWEN_TTS_1_7B_LANES=1
QWEN_TTS_MAX_PARALLEL_GENERATIONS=1

# Hugging Face caches GGUF files outside Git by default.
# HF_HOME=/Volumes/Models/huggingface

# Bind to the LAN. API clients authenticate with Bearer or X-API-Key.
QWEN_TTS_ACCESS_PASSWORD=change-me
HOST=0.0.0.0
PORT=7861

# GGUF model quality. Q4_K_M is fastest/smallest; Q8_0 is higher fidelity.
QWEN_TTS_QUANT=Q4_K_M

# M4 Max 128 GB measured default: two lanes preserve >1x realtime per job
# while improving aggregate throughput by 61% (0.6B) / 52% (1.7B).
QWEN_TTS_0_6B_LANES=2
QWEN_TTS_1_7B_LANES=2
QWEN_TTS_MAX_PARALLEL_GENERATIONS=2
QWEN_TTS_DOCUMENT_PARALLEL_GENERATIONS=2

# Persistent whisper.cpp Metal STT service.
QWEN_STT_SERVER=/opt/homebrew/bin/whisper-server
QWEN_STT_MODEL=.runtime/whisper.cpp/models/ggml-small.bin
QWEN_STT_PORT=7890
QWEN_STT_THREADS=8

# Hugging Face caches GGUF files outside Git by default.
# HF_HOME=/Volumes/Models/huggingface
